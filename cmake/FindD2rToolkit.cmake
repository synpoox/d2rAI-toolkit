# Find the d2rAI-toolkit checkout from a mod project, and check the mod's toolkit.version pin.
# Same rules as tools/toolkit_path.py and tools/ToolkitPath.ps1; see docs/toolkit-finder.md.
#
#   find_package(D2rToolkit REQUIRED)     # sets D2R_TOOLKIT_DIR
#
# Inputs (all optional): D2R_TOOLKIT (env var) forces the folder; D2R_TOOLKIT_FROM (cmake variable) is the
# start folder (default: CMAKE_CURRENT_SOURCE_DIR); D2R_TOOLKIT_STRICT (env var or cmake variable, 1/true/yes/on)
# makes a pin problem a fatal error instead of a warning.

function(_d2r_is_toolkit dir out)
  if(IS_DIRECTORY "${dir}/modkit" AND EXISTS "${dir}/tools/toolkit_path.py")
    set(${out} TRUE PARENT_SCOPE)
  else()
    set(${out} FALSE PARENT_SCOPE)
  endif()
endfunction()

# Sets <out_dir> (empty = not found) and <out_msg> (why).
function(_d2r_find_dir start out_dir out_msg)
  set(${out_dir} "" PARENT_SCOPE)
  if(DEFINED ENV{D2R_TOOLKIT} AND NOT "$ENV{D2R_TOOLKIT}" STREQUAL "")
    _d2r_is_toolkit("$ENV{D2R_TOOLKIT}" ok)
    if(ok)
      get_filename_component(p "$ENV{D2R_TOOLKIT}" ABSOLUTE)
      set(${out_dir} "${p}" PARENT_SCOPE)
    else()
      set(${out_msg} "D2R_TOOLKIT=$ENV{D2R_TOOLKIT} is not a toolkit folder (needs modkit/ and tools/toolkit_path.py)" PARENT_SCOPE)
    endif()
    return()
  endif()
  set(level "${start}")
  while(TRUE)
    foreach(cand "${level}" "${level}/d2rAI-toolkit")
      _d2r_is_toolkit("${cand}" ok)
      if(ok)
        set(${out_dir} "${cand}" PARENT_SCOPE)
        return()
      endif()
    endforeach()
    get_filename_component(parent "${level}" DIRECTORY)
    if(parent STREQUAL level)
      break()
    endif()
    set(level "${parent}")
  endwhile()
  set(${out_msg} "d2rAI-toolkit not found from ${start}: set D2R_TOOLKIT or put d2rAI-toolkit beside the project (or a parent folder of it)" PARENT_SCOPE)
endfunction()

# Reads a small text file as a list of lines, decoding UTF-8 (BOM or not) and UTF-16 (BOM) like the other
# finders. Non-ASCII characters become "?" (they only matter inside comments).
function(_d2r_read_lines file out)
  file(READ "${file}" hex HEX LIMIT 8192)
  string(LENGTH "${hex}" hlen)
  set(pos 0)
  set(step 2)
  set(low 0)
  set(high -1)
  if(hex MATCHES "^efbbbf")
    set(pos 6)
  elseif(hex MATCHES "^fffe")
    set(pos 4)
    set(step 4)
    set(low 0)
    set(high 2)
  elseif(hex MATCHES "^feff")
    set(pos 4)
    set(step 4)
    set(low 2)
    set(high 0)
  endif()
  set(lines "")
  set(cur "")
  while(pos LESS hlen)
    math(EXPR end "${pos} + ${step}")
    if(end GREATER hlen)
      break()
    endif()
    math(EXPR lo_at "${pos} + ${low}")
    string(SUBSTRING "${hex}" ${lo_at} 2 lo_hex)
    set(v 63)
    set(ok TRUE)
    if(high GREATER -1)
      math(EXPR hi_at "${pos} + ${high}")
      string(SUBSTRING "${hex}" ${hi_at} 2 hi_hex)
      if(NOT hi_hex STREQUAL "00")
        set(ok FALSE)
      endif()
    endif()
    if(ok)
      math(EXPR v "0x${lo_hex}")
    endif()
    if(v EQUAL 10)
      list(APPEND lines "${cur}")
      set(cur "")
    elseif(v EQUAL 9)
      string(APPEND cur " ")
    elseif(v EQUAL 13)
      # dropped
    elseif(v LESS 32 OR v GREATER 126 OR v EQUAL 59 OR v EQUAL 91 OR v EQUAL 93)
      string(APPEND cur "?")
    else()
      string(ASCII ${v} ch)
      string(APPEND cur "${ch}")
    endif()
    set(pos ${end})
  endwhile()
  list(APPEND lines "${cur}")
  set(${out} "${lines}" PARENT_SCOPE)
endfunction()

# Sets <out> to a problem message, or "" when the pin matches or there is no pin.
function(_d2r_check_pin start toolkit out)
  set(${out} "" PARENT_SCOPE)
  # The pin belongs to a mod: not for a caller inside the toolkit.
  string(TOLOWER "${start}/" s_l)
  string(TOLOWER "${toolkit}/" t_l)
  string(LENGTH "${t_l}" t_len)
  string(LENGTH "${s_l}" s_len)
  if(NOT s_len LESS t_len)
    string(SUBSTRING "${s_l}" 0 ${t_len} s_head)
    if(s_head STREQUAL t_l)
      return()
    endif()
  endif()
  set(level "${start}")
  set(pin_file "")
  while(TRUE)
    if(EXISTS "${level}/toolkit.version" AND NOT IS_DIRECTORY "${level}/toolkit.version")
      set(pin_file "${level}/toolkit.version")
      break()
    endif()
    if(EXISTS "${level}/.git")
      break()  # the project root ends the walk
    endif()
    get_filename_component(parent "${level}" DIRECTORY)
    if(parent STREQUAL level)
      break()
    endif()
    set(level "${parent}")
  endwhile()
  if(pin_file STREQUAL "")
    return()
  endif()
  _d2r_read_lines("${pin_file}" lines)
  set(pin "")
  foreach(line IN LISTS lines)
    string(STRIP "${line}" line)
    if(NOT line STREQUAL "" AND NOT line MATCHES "^#")
      set(pin "${line}")
      break()
    endif()
  endforeach()
  string(LENGTH "${pin}" n)
  if(NOT pin MATCHES "^[0-9a-fA-F]+$" OR n LESS 7 OR n GREATER 40)
    set(${out} "${pin_file}: the first non-comment line must be a commit SHA (7-40 hex characters)" PARENT_SCOPE)
    return()
  endif()
  find_package(Git QUIET)
  set(head "")
  if(GIT_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${toolkit}" rev-parse HEAD
                    OUTPUT_VARIABLE head OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
      set(head "")
    endif()
  endif()
  if(head STREQUAL "")
    set(${out} "${pin_file} pins ${pin} but HEAD of ${toolkit} could not be read" PARENT_SCOPE)
    return()
  endif()
  string(TOLOWER "${head}" head)
  string(TOLOWER "${pin}" pin_l)
  string(SUBSTRING "${head}" 0 ${n} head_prefix)
  if(NOT head_prefix STREQUAL pin_l)
    set(${out} "${pin_file} pins ${pin} but toolkit ${toolkit} is at ${head}" PARENT_SCOPE)
  endif()
endfunction()

if(DEFINED D2R_TOOLKIT_FROM)
  get_filename_component(_d2r_start "${D2R_TOOLKIT_FROM}" ABSOLUTE)
else()
  set(_d2r_start "${CMAKE_CURRENT_SOURCE_DIR}")
endif()

set(_d2r_err "")
# Strict when the environment variable or the cmake variable is on (read always, so cmake sees it used).
string(TOLOWER "$ENV{D2R_TOOLKIT_STRICT} ${D2R_TOOLKIT_STRICT}" _d2r_strict)
string(REGEX MATCH "(^| )(1|true|yes|on)( |$)" _d2r_strict "${_d2r_strict}")
_d2r_find_dir("${_d2r_start}" _d2r_dir _d2r_err)
if(_d2r_dir)
  set(D2R_TOOLKIT_DIR "${_d2r_dir}")
  _d2r_check_pin("${_d2r_start}" "${_d2r_dir}" _d2r_problem)
  if(_d2r_problem)
    if(_d2r_strict)
      message(FATAL_ERROR "${_d2r_problem}")
    else()
      message(WARNING "${_d2r_problem}")
    endif()
  endif()
endif()

include(FindPackageHandleStandardArgs)
if(_d2r_err STREQUAL "")
  set(_d2r_err "d2rAI-toolkit not found")
endif()
find_package_handle_standard_args(D2rToolkit REQUIRED_VARS D2R_TOOLKIT_DIR FAIL_MESSAGE "${_d2r_err}")
