#!/bin/sh
# Commit-msg hook: the commit message goes through the same scanner as the files.
root=$(git rev-parse --show-toplevel) || exit 1
# The repo's own scanner (the toolkit itself), else the toolkit's that install_hooks.py wrote in (a mod repo).
scanner="$root/tools/check_public.py"
[ -f "$scanner" ] || scanner="@TOOLKIT_SCANNER@"
if [ ! -f "$scanner" ]; then
	echo "commit-msg: scanner not found at $scanner (the toolkit moved): rerun install_hooks.py --root <this repo> from the toolkit" >&2
	exit 1
fi
for py in python3 python "py -3"; do
	if $py -c "import sys; sys.exit(sys.version_info < (3, 9))" >/dev/null 2>&1; then
		exec $py "$scanner" --root "$root" --message-file "$1" --quiet
	fi
done
echo "commit-msg: no Python 3 found, cannot run tools/check_public.py" >&2
exit 1
